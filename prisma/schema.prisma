// Session 2: core storyboard table only.
// BibleEntity and Shot models come in Session 3 once reference-still
// generation is wired up.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password_hash String
  role          UserRole   @default(MEMBER)
  created_at    DateTime   @default(now())
  storyboards   Storyboard[]
  credit_ledger CreditLedger[]
  styles        Style[]

  @@map("users")
}

// Append-only credit ledger. Balance is SUM(delta) — never a mutable column,
// because a lost update there either gives away compute or eats credits a
// user paid for.
model CreditLedger {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // Positive = credits added (purchase, grant, signup bonus, refund).
  // Negative = credits consumed by a generation.
  delta         Int
  reason        String   // purchase | grant | signup_bonus | debit | refund
  storyboard_id String?
  // Provenance for payment-sourced entries; unique so a replayed webhook
  // cannot double-credit the same payment.
  payment_ref   String?  @unique
  note          String?
  created_at    DateTime @default(now())

  @@index([user_id, created_at])
  @@map("credit_ledger")
}

enum UserRole {
  ADMIN
  MEMBER
}

model Storyboard {
  id              String           @id @default(uuid())
  title           String
  // Owner. Null on storyboards created before accounts existed — those are
  // visible to admins and claimed by the first signed-in user to open them.
  user_id         String?
  user            User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)
  source_input    String           @db.Text
  source_markdown String           @db.Text
  parsed_json     Json?
  status          StoryboardStatus @default(DRAFT)
  render_style      RenderStyle      @default(PHOTOREAL)
  image_model       String?
  // LEGACY: superseded by ReferenceStill / ShotFrame rows. Kept read-only for
  // lazy backfill of pre-normalization storyboards; never written anymore.
  reference_stills  Json?
  shot_key_frames   Json?
  continuity_report Json?
  // LEGACY single-image style reference. Superseded by style_id; still read
  // as a fallback for boards created before named styles existed.
  style_ref_url     String?
  // Named style (up to 4 reference images) driving STYLE_REF mode.
  style_id          String?
  style             Style?           @relation(fields: [style_id], references: [id], onDelete: SetNull)
  // Denormalized from parsed_json.shots.length so list views never have to
  // pull the full parsed board. Null on rows parsed before this column existed.
  shot_count        Int?
  // Mood-film audio track (animatic): uploaded music + trim-in point (seconds).
  audio_url         String?
  audio_trim_start  Float            @default(0)
  created_at        DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  shot_frames      ShotFrame[]
  ref_stills       ReferenceStill[]

  @@index([user_id])
  @@map("storyboards")
}

// One row per shot's rendered key frame. Per-row writes are atomic, so a
// regen on shot 7 can never clobber a board run's write to shot 12 (the
// lost-update race the old shot_key_frames Json column had).
model ShotFrame {
  id            String     @id @default(uuid())
  storyboard_id String
  shot_number   Int
  status        String     @default("pending") // pending | generating | done | error
  url           String?
  history       String[]   @default([]) // previous render URLs, newest-first
  error         String?
  updated_at    DateTime   @updatedAt
  storyboard    Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)

  @@unique([storyboard_id, shot_number])
  @@map("shot_frames")
}

// One row per Bible entity's reference still state.
model ReferenceStill {
  id            String     @id @default(uuid())
  storyboard_id String
  entity_id     String // CHAR-* / LOC-* / PROP-*
  status        String     @default("pending") // pending | generating | done | error
  candidates    String[]   @default([])
  selected      String?
  synced_url    String?
  error         String?
  updated_at    DateTime   @updatedAt
  storyboard    Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)

  @@unique([storyboard_id, entity_id])
  @@map("reference_stills_rows")
}

// A director's named look — up to 4 reference images conditioned into every
// generation. Capped at 5 per user (enforced in the API, not the schema).
model Style {
  id          String       @id @default(uuid())
  user_id     String
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name        String
  image_urls  String[]     @default([])
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  storyboards Storyboard[]

  @@index([user_id])
  @@map("styles")
}

enum RenderStyle {
  PHOTOREAL
  WATERCOLOUR_SKETCH
  STYLE_REF
}

enum StoryboardStatus {
  DRAFT
  PARSED
  REFS_PENDING
  REFS_APPROVED
  SHOTS_GENERATING
  COMPLETE
  FAILED
}

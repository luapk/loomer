// Session 2: core storyboard table only.
// BibleEntity and Shot models come in Session 3 once reference-still
// generation is wired up.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password_hash String
  role          UserRole   @default(MEMBER)
  created_at    DateTime   @default(now())
  storyboards   Storyboard[]
  credit_ledger CreditLedger[]
  styles        Style[]

  @@map("users")
}

// Append-only credit ledger. Balance is SUM(delta) — never a mutable column,
// because a lost update there either gives away compute or eats credits a
// user paid for.
model CreditLedger {
  id            String   @id @default(uuid())
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  // Positive = credits added (purchase, grant, signup bonus, refund).
  // Negative = credits consumed by a generation.
  delta         Int
  reason        String   // purchase | grant | signup_bonus | debit | refund
  storyboard_id String?
  // Provenance for payment-sourced entries; unique so a replayed webhook
  // cannot double-credit the same payment.
  payment_ref   String?  @unique
  note          String?
  created_at    DateTime @default(now())

  @@index([user_id, created_at])
  @@map("credit_ledger")
}

enum UserRole {
  ADMIN
  MEMBER
}

model Storyboard {
  id              String           @id @default(uuid())
  title           String
  // Owner. Null on storyboards created before accounts existed — those are
  // visible to admins and claimed by the first signed-in user to open them.
  user_id         String?
  user            User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)
  source_input    String           @db.Text
  source_markdown String           @db.Text
  parsed_json     Json?
  status          StoryboardStatus @default(DRAFT)
  render_style      RenderStyle      @default(PHOTOREAL)
  image_model       String?
  // LEGACY: superseded by ReferenceStill / ShotFrame rows. Kept read-only for
  // lazy backfill of pre-normalization storyboards; never written anymore.
  reference_stills  Json?
  shot_key_frames   Json?
  continuity_report Json?
  // LEGACY single-image style reference. Superseded by style_id; still read
  // as a fallback for boards created before named styles existed.
  style_ref_url     String?
  // Named style (up to 4 reference images) driving STYLE_REF mode.
  style_id          String?
  style             Style?           @relation(fields: [style_id], references: [id], onDelete: SetNull)
  // Denormalized from parsed_json.shots.length so list views never have to
  // pull the full parsed board. Null on rows parsed before this column existed.
  shot_count        Int?
  // Mood-film audio track (animatic): uploaded music + trim-in point (seconds).
  audio_url         String?
  audio_trim_start  Float            @default(0)
  // ElevenLabs voice chosen for this board's voice-over (see src/lib/elevenlabs.ts).
  vo_voice          String?
  created_at        DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  shot_frames      ShotFrame[]
  ref_stills       ReferenceStill[]
  voice_overs      ShotVoiceOver[]
  end_card         EndCard?

  @@index([user_id])
  @@map("storyboards")
}

// One row per shot's rendered key frame. Per-row writes are atomic, so a
// regen on shot 7 can never clobber a board run's write to shot 12 (the
// lost-update race the old shot_key_frames Json column had).
model ShotFrame {
  id            String     @id @default(uuid())
  storyboard_id String
  shot_number   Int
  status        String     @default("pending") // pending | generating | done | error
  url           String?
  history       String[]   @default([]) // previous render URLs, newest-first
  error         String?
  updated_at    DateTime   @updatedAt
  storyboard    Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)

  @@unique([storyboard_id, shot_number])
  @@map("shot_frames")
}

// The board's closing frame: an uploaded end card, or a logo composited over
// the final rendered frame, either optionally carrying an endline.
//
// The layers are stored so the card stays editable, AND the flattened render
// is stored alongside them. Compositing happens in the browser; everything
// downstream (PDF, ZIP, animatic, share) just consumes composited_url like any
// other frame, so no server-side image library is needed anywhere.
model EndCard {
  id            String     @id @default(uuid())
  storyboard_id String     @unique
  // upload  — image_url IS the card.
  // overlay — image_url is a transparent logo drawn over the last frame.
  mode          String     @default("overlay")
  image_url     String?
  endline       String?
  // Logo placement, as fractions of frame size so it survives a resolution change.
  logo_scale    Float      @default(0.3)
  logo_x        Float      @default(0.5)
  logo_y        Float      @default(0.5)
  // overlay mode only: "last_frame", or a hex colour for a solid card.
  background    String     @default("last_frame")
  // The flattened result the rest of the app reads.
  composited_url String?
  updated_at    DateTime   @updatedAt
  storyboard    Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)

  @@map("end_cards")
}

// One row per shot that has a voice-over line. Separate from ShotFrame so
// re-rendering an image never disturbs its audio, and vice versa.
model ShotVoiceOver {
  id            String     @id @default(uuid())
  storyboard_id String
  shot_number   Int
  // The voice slot used (see VOICES in src/lib/elevenlabs.ts), kept so the UI
  // can show when a line was cut with a voice the board no longer uses.
  voice         String
  // The line as spoken — lets us skip regeneration when nothing changed.
  text          String     @db.Text
  url           String
  duration_ms   Int?
  updated_at    DateTime   @updatedAt
  storyboard    Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)

  @@unique([storyboard_id, shot_number])
  @@map("shot_voice_overs")
}

// One row per Bible entity's reference still state.
model ReferenceStill {
  id            String     @id @default(uuid())
  storyboard_id String
  entity_id     String // CHAR-* / LOC-* / PROP-*
  status        String     @default("pending") // pending | generating | done | error
  candidates    String[]   @default([])
  selected      String?
  synced_url    String?
  error         String?
  updated_at    DateTime   @updatedAt
  storyboard    Storyboard @relation(fields: [storyboard_id], references: [id], onDelete: Cascade)

  @@unique([storyboard_id, entity_id])
  @@map("reference_stills_rows")
}

// A director's named look — up to 4 reference images conditioned into every
// generation. Capped at 5 per user (enforced in the API, not the schema).
model Style {
  id          String       @id @default(uuid())
  user_id     String
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name        String
  image_urls  String[]     @default([])
  // One or two sentences describing the look, written by Claude from the
  // images. Shown to the user as a check that the style read correctly, and
  // injected into generation prompts so the style survives on far fewer
  // conditioning images (which would otherwise crowd out identity refs).
  summary     String?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  storyboards Storyboard[]

  @@index([user_id])
  @@map("styles")
}

enum RenderStyle {
  PHOTOREAL
  WATERCOLOUR_SKETCH
  STYLE_REF
}

enum StoryboardStatus {
  DRAFT
  PARSED
  REFS_PENDING
  REFS_APPROVED
  SHOTS_GENERATING
  COMPLETE
  FAILED
}

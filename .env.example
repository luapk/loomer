# Anthropic (required for storyboard generation and parsing)
ANTHROPIC_API_KEY=sk-ant-...

# Google AI (required for reference still + shot generation — Sessions 3-4)
# Get from: aistudio.google.com → Get API key
GOOGLE_AI_API_KEY=...

# Vercel Postgres (required for database)
# Get these from: Vercel dashboard → Storage → your Postgres database → .env.local
DATABASE_URL="postgres://..."
DIRECT_URL="postgres://..."

# Vercel Blob (required for storing generated images — Session 3+)
# Get from: Vercel dashboard → Storage → your Blob store → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Session signing secret for user accounts — any long random string.
# Falls back to LOOMER_PASSWORD if unset (so existing deploys keep working),
# but set a dedicated secret: rotating it signs everyone out.
SESSION_SECRET=generate-a-long-random-string

# Comma-separated emails granted ADMIN on signup/login.
# paulknott@gmail.com is always an admin (hardcoded default).
ADMIN_EMAILS=

# Optional invite gate: when set, creating an account requires this code
# (admin emails are exempt). Leave unset for open signup.
SIGNUP_CODE=

# DEPRECATED: the single-password gate was replaced by email accounts
# (docs/decisions/REVISIT-auth.md). Only used as SESSION_SECRET fallback.
LOOMER_PASSWORD=your-password-here

# Sentry error monitoring (optional — the SDK no-ops when unset).
# Get the DSN from sentry.io → Project Settings → Client Keys (DSN).
# Both names hold the same DSN; the NEXT_PUBLIC_ one reaches the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Source-map upload at build time — optional, but without it production stack
# traces are minified. Create at sentry.io → Settings → Auth Tokens.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
